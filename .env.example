# ═══════════════════════════════════════════════════
# Avatar Catwalk Shop – Konfiguration
# ═══════════════════════════════════════════════════
# Kopiere diese Datei als .env und trage deine Keys ein:
#   cp .env.example .env

# Server
PORT=3000

# ─── KI-Modell Provider ───────────────────────────
# Welcher Provider soll verwendet werden?
# Optionen: replicate | huggingface | local
AI_PROVIDER=replicate

# ─── Replicate (günstigster Cloud-Provider) ──────
# Registriere dich auf https://replicate.com
# API Token: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Modell-Auswahl ──────────────────────────────

# Avatar-Bild Modell (fotorealistische Model-Bilder generieren)
# Standard: black-forest-labs/flux-1.1-pro (~$0.03-0.05/Bild)
AVATAR_MODEL=black-forest-labs/flux-1.1-pro

# Virtual Try-On Modell (Kleidung auf Avatar auftragen)
# Standard: cuuupid/idm-vton (~$0.01-0.03/Bild)
TRYON_MODEL=cuuupid/idm-vton

# Video/Animation Modell (Walking-Video generieren)
# Standard: minimax/video-01 (beste Qualität, ~$0.10-0.20/Video)
# Alternativen: stability-ai/stable-video-diffusion (günstigster, ~$0.03-0.05)
#               kling-ai/v1.6-pro (höchste Qualität, ~$0.15-0.30)
VIDEO_MODEL=minimax/video-01

# ─── Hugging Face (Alternative) ──────────────────
# Nur nötig wenn AI_PROVIDER=huggingface
HUGGINGFACE_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Generierungsoptionen ────────────────────────
# Maximale gleichzeitige Generierungen
MAX_CONCURRENT_GENERATIONS=2

# Cache-Dauer in Stunden (generierte Bilder)
GENERATION_CACHE_HOURS=24

# Bildqualität (low, medium, high)
IMAGE_QUALITY=medium
